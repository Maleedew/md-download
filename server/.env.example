# Copy to .env (or set these in your host's dashboard). Everything is optional.

PORT=8787

# Your Netlify site(s), comma separated. "*" allows any website to use your API (not recommended in production).
ALLOWED_ORIGINS=https://your-site.netlify.app

# --- limits (protect a small server) ---
MAX_CONCURRENT_JOBS=2
MAX_FILE_SIZE_MB=1024
MAX_DURATION_MIN=180
FILE_TTL_MINUTES=15
INFO_PER_MINUTE=20
JOBS_PER_MINUTE=6

# --- YouTube from a data-centre IP ---
# YouTube often answers cloud servers with "Sign in to confirm you're not a bot".
# Fix: export cookies.txt from a logged-in browser (Netscape format), mount it, and point here:
# COOKIES_FILE=/secrets/cookies.txt
# or route yt-dlp through a residential proxy:
# YTDLP_PROXY=http://user:pass@host:port

# Keep yt-dlp fresh on every boot (Docker). 0 = don't update.
AUTO_UPDATE_YTDLP=1
